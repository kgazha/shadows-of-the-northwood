extends Camera2D

## t64 (фаза 1 открытого мира; вердикт пользователя 17.11 10:10 «фазу один делай»,
## роадмап docs/OPEN_WORLD.md). Риг камеры: плавное следование за героем + снап.
##
## Границы ответственности. Лимиты по-прежнему ставит world._set_cam_limits() по
## пиксельным границам текущей зоны — риг к ним не лезет; риг отвечает за ВРЕМЯ
## (сглаживание) и за СНАП (моментальные перестановки героя). Зум 1 и экран
## 640×360 не трогаем: это инвариант OPEN_WORLD и SCALE_CANON.
##
## Сглаживание. Godot за физический кадр съедает delta * position_smoothing_speed
## дистанции, т.е. при 60 кадрах/с доля кадра = speed / 60. Просили 0.15..0.25 —
## берём середину 0.20, значит speed = 0.20 * 60 = 12.0. Число живёт в одном месте
## (FOLLOW_LERP), а qa_cam C1 сверяет производную долю, а не догадки.
##
## limit_smoothed = true — обязательно: без него Godot клампит ЦЕЛЬ, а по
## СГЛАЖЕННОЙ позиции кламп не считается, и в догоняющих кадрах камера выглянула
## бы за границу мира (те самые серые полосы clear-заливки, которые запрещает
## задача). С limit_smoothed предельный кадр всё равно внутри лимитов зоны.
##
## Снап. Смена зоны, резюме из сейва, телепорт к арке и возрождение — это НЕ
## движение: догонять 4800 px (CAVE_OFFSET) нельзя, потому что кадр с краем
## прошлой зоны = баг g18b («вынесло к входу», камера показала старый край).
## world зовёт snap() в этих точках явно; TELEPORT_PX — страховка на случай
## перестановки, до которой мы не доглядели: обычный шаг (≈2.3 px/кадр) и рывок
## (≈5 px/кадр) порог не берут, а любой телепорт — в десятки-тысячи пикселей.

const FOLLOW_LERP := 0.2          # доля дистанции, съедаемая за физический кадр
const TELEPORT_PX := 24.0         # прыжок родителя больше — это телепорт, не шаг

var _prev_owner := Vector2.INF    # позиция родителя в прошлом физическом кадре


func _ready() -> void:
	position_smoothing_enabled = true
	position_smoothing_speed = FOLLOW_LERP * 60.0
	limit_smoothed = true


## Поставить камеру на героя в один кадр (сбросить хвост сглаживания).
func snap() -> void:
	reset_smoothing()
	var p := get_parent()
	_prev_owner = (p as Node2D).global_position if p is Node2D else Vector2.INF


func _physics_process(_delta: float) -> void:
	var p := get_parent()
	if not (p is Node2D):
		return
	var gp: Vector2 = (p as Node2D).global_position
	if _prev_owner != Vector2.INF and gp.distance_to(_prev_owner) > TELEPORT_PX:
		snap()  # телепорт: старый край показать нельзя, догонять нечего
	else:
		_prev_owner = gp
