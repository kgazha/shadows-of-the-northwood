	"slime": "Слайм",
	"swarmling": "Мглокрыс",
	"wraith": "Тенеплёт",
	"archer": "Лесокров-лучник",
	"brute": "Осквернённый Гром",
	"brute_short": "Гром",
	"boss2": "Ведьма Пепелища",
}

## Отображаемое имя достижения по id — общее для журнала и тоста анлока
## (achv.gd::_title обязан звать это, а не держать свою копию имён).
static func name_of(id: String) -> String:
	for raw_c in ITEMS:
		var c: Dictionary = raw_c
		if String(c.get("id", "")) == id:
			return String(c.get("name", id))
	return id
