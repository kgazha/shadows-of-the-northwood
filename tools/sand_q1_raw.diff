index 97153cc..9de2643 100644
--- a/tools/qa_q1_pristine_dz.gd
+++ b/sand_q1/pixel-rpg/scripts/dungeon_zone.gd
@@ -57,12 +57,14 @@ func setup(p_world: Node2D) -> void:
 	# отметить дверь открытой после сборки — дотягиваем состояние по факту.
 	GameState.stats_changed.connect(_sync_door)
 	GameState.stats_changed.connect(_sync_chest)
+	GameState.stats_changed.connect(_sync_boss)
 	_sync_door()
 	_spawn_entities(m)
 	# Охранения в _spawn_entities читают флаги ДО load_game(), поэтому при заходе
 	# с открытыми дверью/сундуком узел всё же успел заспавниться — снимаем его.
 	_sync_door()
 	_sync_chest()
+	_sync_boss()
 
 func tile_to_world(t: Vector2i) -> Vector2:
 	return Vector2((t.x + 0.5) * TILE, (t.y + 0.5) * TILE + 2.0)
@@ -168,6 +170,20 @@ func _sync_door() -> void:
 		if n is CaveDoor:
 			_kill_ghost(n)
 
+## Босс убит по сохранённому состоянию (cave_state>=2): снятый при сборке узел
+## всё равно заспавнился, т.к. _spawn_entities читает флаги ДО load_game().
+## Без уборки живой босс бьёт героя и повторно выдаёт XP/лут после каждой
+## перезагрузки (ферма награды), вопреки персисту «босс мёртв». Идемпотентно.
+func _sync_boss() -> void:
+	if not GameState.boss_defeated:
+		return
+	if boss_node != null and is_instance_valid(boss_node):
+		boss_node.remove_from_group("enemy")
+		if boss_node.is_in_group("boss"):
+			boss_node.remove_from_group("boss")
+		boss_node.queue_free()
+		boss_node = null
+
 ## Сундук открыт (амулет взят): тайл 11 -> 12 и снимаем фантом «Открыть сундук».
 ## Фантом не косметика: повторный клик по нему снова даёт heal(4) и реплику.
 ## Идемпотентно — сборка пещеры, загрузка сейва, F9, открытие в этой сессии.
